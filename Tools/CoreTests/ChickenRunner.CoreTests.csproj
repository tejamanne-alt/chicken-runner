<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the engine-free rules (Assets/ChickenRunner/Scripts/Core) and their NUnit tests
    without Unity:  dotnet test Tools/CoreTests
    The same test files also run in Unity's Test Runner when the Test Framework package is installed.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/ChickenRunner/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/ChickenRunner/Tests/EditMode/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
